{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Xbox Mode",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/start.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Xbox Mode (windowed)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/start.js",
      "args": ["--windowed"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
