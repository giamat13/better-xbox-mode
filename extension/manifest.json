{
  "manifest_version": 3,
  "name": "Xbox Mode Gamepad Support",
  "version": "0.1.0",
  "description": "Drive pages that have no gamepad support with a controller. Pages that read gamepads themselves are left alone.",
  "minimum_chrome_version": "111",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["osk.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["http://127.0.0.1:8765/*"]
}
